# Structure de base pour LDAP
dn: ou=people,dc=kerialis,dc=local
objectClass: organizationalUnit
ou: people
description: Utilisateurs de l'organisation

dn: ou=groups,dc=kerialis,dc=local
objectClass: organizationalUnit
ou: groups
description: Groupes de l'organisation

# Exemple d'utilisateur de test
dn: uid=jdoe,ou=people,dc=kerialis,dc=local
objectClass: inetOrgPerson
objectClass: organizationalPerson
objectClass: person
objectClass: top
cn: John Doe
sn: Doe
givenName: John
uid: jdoe
mail: john.doe@kerialis.local
userPassword: password123

# Exemple de groupe
dn: cn=users,ou=groups,dc=kerialis,dc=local
objectClass: groupOfNames
cn: users
member: uid=jdoe,ou=people,dc=kerialis,dc=local
description: Groupe des utilisateurs standards
